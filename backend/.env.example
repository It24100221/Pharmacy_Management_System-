# ============================================================================
# Backend configuration — Microsoft SQL Server (Stage 0B)
# Copy to backend/.env and fill in the values. NEVER commit backend/.env.
# All values below are placeholders; no real server name or credential lives
# in this repository.
# ============================================================================

# --- Server ---------------------------------------------------------------
# Host name or IP of the computer running SQL Server (the "other computer").
# Obtain it from SSMS: Object Explorer > right-click the server > Properties >
# General > "Name", or run: SELECT @@SERVERNAME;
DB_SERVER=CHANGE_ME_HOSTNAME_OR_IP

# Named instance, e.g. SQLEXPRESS. Leave empty for a default instance.
# When set, the driver connects as DB_SERVER\DB_INSTANCE and DB_PORT is ignored.
DB_INSTANCE=SQLEXPRESS

# TCP port. Only used when DB_INSTANCE is empty. Default SQL Server port 1433.
DB_PORT=1433

# Database name created by database/mssql/*.sql
DB_DATABASE=pharmacy_management

# --- Authentication -------------------------------------------------------
# true  -> Windows Authentication (Trusted_Connection=yes), the required mode.
# false -> SQL Authentication; DB_USER then becomes mandatory. Only set this
#          false if the project owner explicitly changes the authentication
#          requirement. It is never used as a silent fallback.
DB_TRUSTED_CONNECTION=true

# Used only when DB_TRUSTED_CONNECTION=false. Leave empty otherwise.
DB_USER=
DB_PASSWORD=

# --- Connectivity ---------------------------------------------------------
# ODBC driver name as registered in ODBC Data Sources (64-bit).
# This machine currently has only the legacy "SQL Server" driver:
#   reg query "HKLM\SOFTWARE\ODBC\ODBCINST.INI\ODBC Drivers"
# If "ODBC Driver 17/18 for SQL Server" or "SQL Server Native Client 11.0"
# becomes available, point DB_DRIVER at it here.
DB_DRIVER={SQL Server}

# true only when the server requires encrypted connections (SQL Server 2019+
# defaults). Local SQLEXPRESS usually needs false.
DB_ENCRYPT=false

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# --- Application ----------------------------------------------------------
PORT=5000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
